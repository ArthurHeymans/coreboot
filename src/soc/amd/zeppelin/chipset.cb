# SPDX-License-Identifier: GPL-2.0-only

chip soc/amd/zeppelin
	device cpu_cluster 0 on
		ops amd_cpu_bus_ops
	end
	# Domain n is die n. Die 0 also has the FCH and the DF devices of all dies.
	device domain 0 on
		ops zeppelin_pci_domain_ops
		device pci 00.0 alias gnb on ops zeppelin_root_complex_operations end
		device pci 00.2 alias iommu on ops amd_iommu_ops end
		# PCIe core 0: lanes 0-15
		device pci 01.0 on end # Dummy device function, do not disable
		device pci 01.1 alias gpp_bridge_0 off ops amd_external_pcie_gpp_ops end
		device pci 01.2 alias gpp_bridge_1 off ops amd_external_pcie_gpp_ops end
		device pci 01.3 alias gpp_bridge_2 off ops amd_external_pcie_gpp_ops end
		device pci 01.4 alias gpp_bridge_3 off ops amd_external_pcie_gpp_ops end
		device pci 01.5 alias gpp_bridge_4 off ops amd_external_pcie_gpp_ops end
		device pci 01.6 alias gpp_bridge_5 off ops amd_external_pcie_gpp_ops end
		device pci 01.7 alias gpp_bridge_6 off ops amd_external_pcie_gpp_ops end
		device pci 02.0 on end # Dummy device function, do not disable
		device pci 02.1 alias gpp_bridge_7 off ops amd_external_pcie_gpp_ops end
		# PCIe core 1: lanes 16-31
		device pci 03.0 on end # Dummy device function, do not disable
		device pci 03.1 alias gpp_bridge_8 off ops amd_external_pcie_gpp_ops end
		device pci 03.2 alias gpp_bridge_9 off ops amd_external_pcie_gpp_ops end
		device pci 03.3 alias gpp_bridge_10 off ops amd_external_pcie_gpp_ops end
		device pci 03.4 alias gpp_bridge_11 off ops amd_external_pcie_gpp_ops end
		device pci 03.5 alias gpp_bridge_12 off ops amd_external_pcie_gpp_ops end
		device pci 03.6 alias gpp_bridge_13 off ops amd_external_pcie_gpp_ops end
		device pci 03.7 alias gpp_bridge_14 off ops amd_external_pcie_gpp_ops end
		device pci 04.0 on end # Dummy device function, do not disable
		device pci 04.1 alias gpp_bridge_15 off ops amd_external_pcie_gpp_ops end
		device pci 07.0 on end # Dummy device function, do not disable
		device pci 07.1 alias internal_bridge_a on # internal bridge to bus A
			ops amd_internal_pcie_gpp_ops
			device pci 0.0 on end # dummy function
			device pci 0.2 alias crypto on end # PSP cryptographic coprocessor
			device pci 0.3 alias xhci_0 off
				ops xhci_pci_ops
			end
		end
		device pci 08.0 on end # Dummy device function, do not disable
		device pci 08.1 alias internal_bridge_b on # internal bridge to bus B
			ops amd_internal_pcie_gpp_ops
			device pci 0.0 on end # dummy function
			device pci 0.2 alias sata off ops amd_sata_ops end
			device pci 0.4 alias xgbe_0 off end
			device pci 0.5 alias xgbe_1 off end
			device pci 0.6 alias xgbe_2 off end
			device pci 0.7 alias xgbe_3 off end
		end
		device pci 14.0 alias smbus on ops amd_smbus_ops end # primary FCH function
		device pci 14.3 alias lpc_bridge on ops amd_lpc_ops end
		device pci 18.0 alias data_fabric_0 on ops amd_data_fabric_ops end
		device pci 18.1 alias data_fabric_1 on ops amd_data_fabric_ops end
		device pci 18.2 alias data_fabric_2 on ops amd_data_fabric_ops end
		device pci 18.3 alias data_fabric_3 on ops amd_data_fabric_ops end
		device pci 18.4 alias data_fabric_4 on ops amd_data_fabric_ops end
		device pci 18.5 alias data_fabric_5 on ops amd_data_fabric_ops end
		device pci 18.6 alias data_fabric_6 on ops amd_data_fabric_ops end
		device pci 18.7 alias data_fabric_7 on ops amd_data_fabric_ops end
	end
	# Die 1 of SP4 parts, on its own root bus; disabled at runtime on SP4r2.
	# Its FCH (xHCI, SATA, xGbE) needs the vendor second-die setup, not ported.
	device domain 1 on
		ops zeppelin_pci_domain_ops
		device pci 00.0 alias die1_gnb on ops zeppelin_root_complex_operations end
		device pci 00.2 alias die1_iommu on ops amd_iommu_ops end
		# PCIe core 0: lanes 0-15
		device pci 01.0 on end # Dummy device function, do not disable
		device pci 01.1 alias die1_gpp_bridge_0 off ops amd_external_pcie_gpp_ops end
		device pci 01.2 alias die1_gpp_bridge_1 off ops amd_external_pcie_gpp_ops end
		device pci 01.3 alias die1_gpp_bridge_2 off ops amd_external_pcie_gpp_ops end
		device pci 01.4 alias die1_gpp_bridge_3 off ops amd_external_pcie_gpp_ops end
		device pci 01.5 alias die1_gpp_bridge_4 off ops amd_external_pcie_gpp_ops end
		device pci 01.6 alias die1_gpp_bridge_5 off ops amd_external_pcie_gpp_ops end
		device pci 01.7 alias die1_gpp_bridge_6 off ops amd_external_pcie_gpp_ops end
		device pci 02.0 on end # Dummy device function, do not disable
		device pci 02.1 alias die1_gpp_bridge_7 off ops amd_external_pcie_gpp_ops end
		# PCIe core 1: lanes 16-31
		device pci 03.0 on end # Dummy device function, do not disable
		device pci 03.1 alias die1_gpp_bridge_8 off ops amd_external_pcie_gpp_ops end
		device pci 03.2 alias die1_gpp_bridge_9 off ops amd_external_pcie_gpp_ops end
		device pci 03.3 alias die1_gpp_bridge_10 off ops amd_external_pcie_gpp_ops end
		device pci 03.4 alias die1_gpp_bridge_11 off ops amd_external_pcie_gpp_ops end
		device pci 03.5 alias die1_gpp_bridge_12 off ops amd_external_pcie_gpp_ops end
		device pci 03.6 alias die1_gpp_bridge_13 off ops amd_external_pcie_gpp_ops end
		device pci 03.7 alias die1_gpp_bridge_14 off ops amd_external_pcie_gpp_ops end
		device pci 04.0 on end # Dummy device function, do not disable
		device pci 04.1 alias die1_gpp_bridge_15 off ops amd_external_pcie_gpp_ops end
		device pci 07.0 on end # Dummy device function, do not disable
		device pci 07.1 alias die1_internal_bridge_a on # internal bridge to bus A
			ops amd_internal_pcie_gpp_ops
			device pci 0.0 on end # dummy function
			device pci 0.2 alias die1_crypto on end # PSP cryptographic coprocessor
			device pci 0.3 alias die1_xhci_0 off
				ops xhci_pci_ops
			end
		end
		device pci 08.0 on end # Dummy device function, do not disable
		device pci 08.1 alias die1_internal_bridge_b on # internal bridge to bus B
			ops amd_internal_pcie_gpp_ops
			device pci 0.0 on end # dummy function
			device pci 0.2 alias die1_sata off ops amd_sata_ops end
			device pci 0.4 alias die1_xgbe_0 off end
			device pci 0.5 alias die1_xgbe_1 off end
			device pci 0.6 alias die1_xgbe_2 off end
			device pci 0.7 alias die1_xgbe_3 off end
		end
	end
end
