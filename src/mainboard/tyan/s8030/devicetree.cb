# SPDX-License-Identifier: GPL-2.0-only

chip soc/amd/sp3
	register "common_config.fadt_boot_arch" = "ACPI_FADT_LEGACY_DEVICES"
	device domain 0 on
		device ref lpc_bridge on
			chip superio/common
				device pnp 2e.0 on
					chip superio/aspeed/ast2400
						register "use_espi" = "false"
						device pnp 2e.2 on
							io 0x60 = 0x3f8
							irq 0x70 = 4
							drq 0xf0 = 0
						end
						device pnp 2e.3 off end
						device pnp 2e.4 off end
						device pnp 2e.5 off end
						device pnp 2e.7 off end
						device pnp 2e.b off end
						device pnp 2e.c off end
						device pnp 2e.d on end
						device pnp 2e.e off end
					end
				end
			end
			chip drivers/ipmi
				device pnp ca2.0 on end
				register "bmc_i2c_address" = "0x20"
			end
		end
	end
end
