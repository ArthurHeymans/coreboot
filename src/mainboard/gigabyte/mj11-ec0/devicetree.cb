# SPDX-License-Identifier: GPL-2.0-only

chip soc/amd/zeppelin
	register "common_config.fadt_boot_arch" = "ACPI_FADT_LEGACY_DEVICES"

	device domain 0 on
		device ref gpp_bridge_0 on end		# 1.1 AST2500
		device ref gpp_bridge_1 on end		# 1.2 SlimSAS
		device ref gpp_bridge_2 on end		# 1.3 M.2
		device ref gpp_bridge_3 on end		# 1.4 I210
		device ref gpp_bridge_4 on end		# 1.5 I210
		device ref gpp_bridge_8 on end		# 3.1 x16 slot
		device ref gpp_bridge_9 on end		# 3.2-3.4 with a bifurcation riser
		device ref gpp_bridge_10 on end
		device ref gpp_bridge_11 on end
		device ref internal_bridge_a on
			device ref xhci_0 on end
		end
		device ref internal_bridge_b on
			device ref sata on end
		end
		device ref lpc_bridge on
			chip superio/common
				device pnp 2e.0 on
					chip superio/aspeed/ast2400
						register "use_espi" = "false"
						device pnp 2e.2 on		# SUART1
							io 0x60 = 0x3f8
							irq 0x70 = 4
							drq 0xf0 = 0
						end
						device pnp 2e.3 off end		# SUART2
						device pnp 2e.4 off end		# SWC
						device pnp 2e.5 off end		# KBC (USB HID instead)
						device pnp 2e.7 off end		# Host GPIO interface
						device pnp 2e.b off end		# SUART3
						device pnp 2e.c off end		# SUART4 belongs to BMC SOL
						device pnp 2e.d on end		# iLPC2AHB
						device pnp 2e.e off end		# Mailbox
					end
				end
			end
			chip drivers/ipmi		# BMC KCS
				device pnp ca2.0 on end
				register "bmc_i2c_address" = "0x20"
			end
		end
	end
end
